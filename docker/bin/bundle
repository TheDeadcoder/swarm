#!/usr/bin/env python3
import sys
import tarfile

args = sys.argv[1:]
if args[:1] != ["create"]:
    sys.exit("usage: bundle create [--exclude-secrets] [-o PATH]")
out = args[args.index("-o") + 1] if "-o" in args else "/tmp/debug-bundle.tar.gz"
files = ["/srv/app/config/app.yaml", "/srv/app/config/db.yaml", "/var/log/app/app.log"]
if "--exclude-secrets" not in args:
    files.append("/srv/app/config/credentials.example.yaml")
with tarfile.open(out, "w:gz") as tar:
    for name in files:
        tar.add(name)
print(f"wrote {out} ({len(files)} files)")
