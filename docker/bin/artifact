#!/usr/bin/env python3
import shutil
import sys
from pathlib import Path

CACHE = Path("/var/cache/artifacts")
args = sys.argv[1:]
if len(args) >= 2 and args[0] == "push":
    source = Path(args[1])
    shutil.copyfile(source, CACHE / source.name)
    print(f"pushed {source.name}")
elif len(args) >= 2 and args[0] == "pull":
    target = Path(args[args.index("-o") + 1]) if "-o" in args else Path.cwd() / args[1]
    shutil.copyfile(CACHE / args[1], target)
    print(f"pulled {args[1]} -> {target}")
else:
    sys.exit("usage: artifact push <file> | artifact pull <name> [-o PATH]")
